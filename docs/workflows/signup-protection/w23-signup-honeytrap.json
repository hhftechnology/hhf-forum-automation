    {
      "id": "3450d048-a6af-4334-99b7-3d47f0dbae44",
      "type": "action:code",
      "typeVersion": "1.0",
      "name": "Read signup check",
      "parameters": {
        "mode": "runOnceForAllItems",
        "code": "// Reads the hidden \"Signup check\" user field written by the\n// \"HHF signup honeytrap\" theme component and decides what to do.\nconst user = $(\"Get user\").first().json.user || {};\nconst created = $(\"User created\").first().json.user || {};\nconst FIELD = \"user_field_8\";\nconst raw = String(\n  (user.custom_fields && user.custom_fields[FIELD]) ??\n    (user.user_fields && user.user_fields[\"8\"]) ??\n    \"\",\n).trim();\n\nif (user.staff || user.admin || user.moderator || user.staged || created.staged) {\n  return [{ verdict: \"skip\", reasons: [], raw, username: user.username || created.username }];\n}\n\nconst signals = {};\nif (raw.startsWith(\"v1|\")) {\n  for (const part of raw.slice(3).split(\"|\")) {\n    const [k, v] = part.split(\"=\");\n    signals[k] = Number(v);\n  }\n}\n\nconst trap = [];\nconst weak = [];\nif (signals.a) trap.push(\"filled the hidden decoy field (invisible to people)\");\nif (signals.b) trap.push(\"filled the field that asks AI agents to identify themselves\");\nif (signals.wd) trap.push(\"browser reported automation (navigator.webdriver)\");\nif (signals.tamper) trap.push(\"the hidden Signup check field was written by something other than the page\");\nif (raw && !raw.startsWith(\"v1|\")) trap.push(\"Signup check field holds unexpected text\");\n\nif (!raw) weak.push(\"no Signup check value (signup did not run the page script: API, scripted or invite signup)\");\nif (raw.startsWith(\"v1|\")) {\n  if (signals.ms < 5000) weak.push(`form completed in ${Math.round(signals.ms / 100) / 10}s`);\n  if (!signals.keys && !signals.ptr) weak.push(\"no real keyboard or pointer events while filling the form\");\n}\n\nconst verdict = trap.length ? \"trap\" : weak.length ? \"weak\" : \"clean\";\nconst lines = trap.map((r) => `- ❗ ${r}`).concat(weak.map((r) => `- ⚠️ ${r}`));\nconst reason =\n  (verdict === \"trap\"\n    ? \"**Signup honeytrap tripped.** The account was added to the \\\"monitor\\\" group and locked at trust level 0, so its posts are hidden until a moderator reviews them. To clear it, use the post menu button \\\"add/revoke monitor group membership\\\" or remove the user from the monitor group.\\n\\n\"\n    : \"**Signup looked automated (weak signals only).** No restrictions were applied.\\n\\n\") +\n  lines.join(\"\\n\") +\n  `\\n\\nRaw signal: \\`${raw || \"(empty)\"}\\``;\n\nreturn [{ verdict, reasons: trap.concat(weak), reason, raw, username: user.username || created.username }];\n"
      },
      "credentials": {},
      "webhookId": null,
      "position": {
        "x": 720,
        "y": 0
      }
    },

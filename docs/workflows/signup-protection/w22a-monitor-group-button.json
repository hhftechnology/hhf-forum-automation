      "type": "action:code",
      "typeVersion": "1.0",
      "name": "Determine action",
      "parameters": {
        "code": "const userData = $(\"Get user data\").first().json;\n\nfor (group of userData.user.groups) {\n  // 103 is the ID of the `monitor` user group.\n  if (group.id ==  $vars.monitor_group_id) {\n    return [\n      {\n        action: \"remove\",\n        confirmation: 'Remove post author from \"monitor\" user group?',\n      },\n    ];\n  }\n}\n\nreturn [\n  {\n    action: \"add\",\n    confirmation: 'Add post author to \"monitor\" user group?',\n  },\n];\n",
        "mode": "runOnceForAllItems"
      },
      "credentials": {},
      "webhookId": null,

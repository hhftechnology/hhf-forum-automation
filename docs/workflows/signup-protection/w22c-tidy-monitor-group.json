    {
      "id": "92f4759a-aee7-4d77-9234-601b8110afb7",
      "type": "action:sql",
      "typeVersion": "1.0",
      "name": "Get suspended members",
      "parameters": {
        "query": "SELECT\n  users.username\nFROM\n  group_users\n  INNER JOIN users ON group_users.user_id = users.id\nWHERE\n  group_users.group_id = :monitor_group_id\n  AND users.suspended_at IS NOT null\n  -- Exclude temporarily suspended users.\n  AND users.suspended_till > CURRENT_TIMESTAMP + 'P500Y'\n",
        "params": {
          "values": [
            {
              "name": "monitor_group_id",
              "value": "={{ $vars.monitor_group_id }}"
            }
          ]
        },
        "operation": "raw"
      },

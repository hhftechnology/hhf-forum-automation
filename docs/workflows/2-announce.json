{
  "name": "HHF: announce published automation posts",
  "description": "Posts an announcement in News when a draft reaches the published category.",
  "nodes": [
    {
      "id": "moved",
      "type": "trigger:topic_category_changed",
      "typeVersion": "1.0",
      "name": "Topic moved",
      "parameters": {},
      "credentials": {},
      "webhookId": null,
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "check",
      "type": "condition:if",
      "typeVersion": "1.0",
      "name": "Moved into source category",
      "parameters": {
        "combinator": "and",
        "conditions": [
          {
            "id": "cond-003",
            "operator": {
              "type": "number",
              "operation": "equals",
              "singleValue": false
            },
            "leftValue": "={{ $json.topic.category_id }}",
            "rightValue": "86"
          }
        ]
      },
      "credentials": {},
      "webhookId": null,
      "position": {
        "x": 240,
        "y": 0
      }
    },
    {
      "id": "published",
      "type": "trigger:topic_published",
      "typeVersion": "1.0",
      "name": "Topic published",
      "parameters": {
        "category_ids": [
          86
        ]
      },
      "credentials": {},
      "webhookId": null,
      "position": {
        "x": 0,
        "y": 160
      }
    },
    {
      "id": "announce",
      "type": "action:topic",
      "typeVersion": "2.0",
      "name": "Announce in News",
      "parameters": {
        "operation": "create",
        "title": "={{ \"New: \" + $json.topic.title }}",
        "raw": "=A new post is available: [{{ $json.topic.title }}]({{ $json.topic.url }})",
        "category_id": 87,
        "actor_username": "system"
      },
      "credentials": {},
      "webhookId": null,
      "position": {
        "x": 480,
        "y": 80
      }
    }
  ],
  "connections": {
    "Topic moved": {
      "main": [
        [
          {
            "node": "Moved into source category",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Moved into source category": {
      "main": [
        [
          {
            "node": "Announce in News",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Topic published": {
      "main": [
        [
          {
            "node": "Announce in News",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
